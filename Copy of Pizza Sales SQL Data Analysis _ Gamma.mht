@charset "utf-8";

.overlay-svg { z-index: 1; pointer-events: none; position: absolute; top: 0px; left: 0px; }

.overlay-clickable { pointer-events: none; z-index: 2; width: 100%; height: 100%; position: absolute; top: 0px; left: 0px; }

@keyframes popoverBounce { 
  0% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
  100% { transform: translateY(0px); }
}

[data-id="tour-popover-content"] { animation: 0.5s ease-in-out 0s 1 normal none running popoverBounce; }

@keyframes animateStrike { 
  0% { background-size: 0% 2px; }
  100% { background-size: 100% 2px; }
}

@keyframes animateStrikeRtl { 
  0% { background-position: 100% center; background-size: 0% 2px; }
  100% { background-position: 100% center; background-size: 100% 2px; }
}

.strike-animation { animation: 0.5s ease-in-out 0s 1 normal none running animateStrike; }

.strike-animation-rtl { animation: 0.5s ease-in-out 0s 1 normal none running animateStrikeRtl; }

@keyframes pulseListItem { 
  0% { background: 0px 0px; }
  50% { background: var(--checklist-item-highlight-color); }
  100% { background: 0px 0px; }
}

.highlight-animation { animation: 1s ease-in-out 0s 1 normal none running pulseListItem; }

@keyframes pointerAnimationRtl { 
  0% { opacity: 1; animation-timing-function: ease-in; transform: translate(-50%); }
  24% { opacity: 1; }
  40% { animation-timing-function: ease-in; transform: translate(-28%); }
  65% { animation-timing-function: ease-in; transform: translate(-15%); }
  25%, 55%, 75% { animation-timing-function: ease-out; transform: translate(0px); }
  100% { opacity: 1; animation-timing-function: ease-out; transform: translate(0px); }
}

@keyframes pointerAnimationLtr { 
  0% { opacity: 1; animation-timing-function: ease-in; transform: translate(50%); }
  24% { opacity: 1; }
  40% { animation-timing-function: ease-in; transform: translate(28%); }
  65% { animation-timing-function: ease-in; transform: translate(15%); }
  25%, 55%, 75% { animation-timing-function: ease-out; transform: translate(0px); }
  100% { opacity: 1; animation-timing-function: ease-out; transform: translate(0px); }
}

.pointer-animation-rtl { animation: 1.5s ease 0s 1 normal forwards running pointerAnimationRtl; }

.pointer-animation-ltr { animation: 1.5s ease 0s 1 normal forwards running pointerAnimationLtr; }
